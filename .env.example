DATABASE_URL=postgresql://cybercheck:CHANGEME@127.0.0.1:5432/cybercheck

# ---- AI (Anthropic). Add your key; spending stops at the daily/monthly caps below. ----
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
AI_DAILY_BUDGET_USD=1.60
AI_MONTHLY_BUDGET_USD=48

# ---- Page fetcher (sandbox behind the VPN; docs/FETCHER.md) ----
# Start it with BOTH env files (the VPN secrets, incl. GLUETUN_API_KEY, live in vpn.env, mode 600):
#   docker compose --env-file .env --env-file vpn.env --profile fetch up -d && ./scripts/verify-sandbox.sh
FETCHER_URL=http://127.0.0.1:8432
FETCHER_TOKEN=                          # at least 16 random characters: openssl rand -hex 24
FETCH_MIN_SCORE=60
SCREENSHOT_RETENTION_DAYS=60

# ---- Reporting: off | review (drafts only) | auto (sends above AUTO_REPORT_MIN_FINAL_SCORE) ----
REPORTING_MODE=review
AUTO_REPORT_MIN_FINAL_SCORE=90          # never below 90; above 100 turns automatic sends off
REPORT_RATE_PER_HOUR=10
REPORTER_EMAIL=                         # role mailbox on a domain you own; Netcraft stays off without it
NETCRAFT_API_KEY=                       # unused: the Netcraft v3 report API takes no key
# SMTP for approved email drafts; off unless all five are set (docs/REPORTING.md)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=

# ---- Blocklist ----
BLOCKLIST_MIN_FINAL_SCORE=90            # never below 90 (the no-evidence cap is 89)
BLOCKLIST_DAYS=90
# BLOCKLIST_CZDS_TERMS_OK=              # 'yes' lets CZDS-found domains into the public list; read docs/CZDS.md first

# ---- ICANN CZDS (optional) ----
CZDS_USERNAME=
CZDS_PASSWORD=
CZDS_TLDS=

# ---- Telegram bot (optional) ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHATS=
BOT_DAILY_LIMIT_PER_CHAT=20

# ---- Optional tuning (defaults shown) ----
# DNS_RESOLVERS=1.1.1.1,9.9.9.10        # unfiltered public resolvers only
# AI_EFFORT=low
# AI_FALLBACKS=default                  # server-side refusal fallback (a declined call may be re-run on an older Opus); 'off' disables
# AI_TIMEOUT_S=120
# AI_TRIAGE_ENABLED=true                # cheap name-only triage for review/high domains with no page after AI_TRIAGE_AFTER_H
# AI_TRIAGE_BUDGET_FRACTION=0.25
# AI_JUDGE_PER_RUN=10
# AI_ENABLED=true                       # false turns every AI call off, even with ANTHROPIC_API_KEY set
# AI_TRIAGE_MODEL=                      # model for name-only triage; empty uses AI_MODEL
# AI_TRIAGE_AFTER_H=2                   # hours after first seen before a domain without a page is triaged
# AI_TRIAGE_INTERVAL_MIN=15             # minutes between triage runs
# AI_JUDGE_MAX_AGE_H=72                 # snapshots older than this many hours are never judged
# AI_JUDGE_COOLDOWN_H=12                # hours before a domain's pages are judged again (failed calls count too)
# FINAL_SCORE_BATCH=500                 # final scores recomputed per judge run
# CONFIDENCE_REQUIRE_AI=true            # auto-report level needs an AI 'phishing' verdict as well as page
#                                       # evidence; false only matters below 90, the fixed cap of 89 always holds
# ENRICH_BATCH_SIZE=50
# ENRICH_CONCURRENCY=10
# ENRICH_TRACK_DAYS=30
# ENRICH_RDAP_REFRESH_HOURS=24          # hours between RDAP lookups of an untracked domain (tracked: hourly)
# ENRICH_DNS_TIMEOUT=3                  # seconds a DNS lookup may take in total (0.5 to 30)
# BLOCKLIST_BUILD_INTERVAL=600          # seconds between blocklist rebuilds (at least 60)
# BLOCKLIST_HOMEPAGE=
# BLOCKLIST_CONTACT=
# BLOCKLIST_LICENSE=not yet decided
# BOT_AI_DAILY_LIMIT_PER_CHAT=5
# scoring and ingest
# STORE_THRESHOLD=40                    # lowest domain-name score that is stored (tier watch)
# REVIEW_THRESHOLD=60                   # domain-name score for tier review
# HIGH_THRESHOLD=75                     # domain-name score for tier high; the docs describe 40 / 60 / 75
# WATCH_DAYS=14                         # domains are re-checked until this many days after their last certificate
# WATCHLIST_PATH=config/watchlist.yaml  # the brand watchlist
# CERTSTREAM_URL=ws://127.0.0.1:8431/   # certstream websocket that ingest reads
# CYBERCHECK_DATA_DIR=data              # screenshots, blocklist files, CZDS downloads (default: data/ in the project)
# worker jobs
# JOB_<NAME>_ENABLED=true               # false turns one job off, e.g. JOB_CZDS_ENABLED=false. Jobs: blocklist,
#                                       # czds, enrich, fetch, housekeeping, judge, report, retention
# dashboard
# WEB_HOST=127.0.0.1                    # bind address; a specific IP (e.g. your tailnet IP) is allowed as a Host too
# WEB_PORT=8430
# WEB_PUBLIC_HOSTNAME=                  # name(s) a proxy shows the browser, e.g. dashboard.example.ts.net when you
#                                       # use `tailscale serve --bg --https=8430 http://127.0.0.1:8430`
# WEB_ALLOWED_HOSTS=                    # full replacement list of Host values the dashboard answers on
#                                       # (DNS-rebinding guard); default: 127.0.0.1:8430,localhost:8430 plus the
#                                       # WEB_PUBLIC_HOSTNAME names (with :8430 and without a port)
# fetch / retention
# FETCH_CONCURRENCY=2
# FETCH_MIN_FREE_GB=10                  # no screenshot/HTML files are written below this much free disk
# FETCH_BATCH=20
# FETCH_EXPECTED_COUNTRY=AU             # egress country the fetcher must see; empty disables the check
# FETCH_TRACK_INTERVAL_H=2              # re-fetch interval for confirmed / reported / AI-phishing domains
# FETCH_MAX_PAGES=200                   # fetcher restarts Chromium after this many pages
# RETENTION_BATCH=500
# reporting
# REPORTER_NAME=CyberCheck
# REPORT_CHANNEL_MIN_INTERVAL_S=60
# REPORT_MAX_ATTEMPTS=5
# REPORT_LOOKBACK_DAYS=30
# REPORT_AI_DRAFTS=true
# REPORT_AI_DRAFTS_PER_RUN=3
# REPORT_MANUAL_CHANNELS=scamwatch,google_safe_browsing,microsoft_smartscreen,cloudflare_abuse_form,auda_dns_abuse,brand_form
# NETCRAFT_ENABLED=true
# NETCRAFT_TEST=false                   # true sends to Netcraft's test endpoint
# CZDS (docs/CZDS.md)
# CZDS_WINDOW_START=06:30               # UTC
# CZDS_WINDOW_HOURS=8
# CZDS_MAX_ZONE_GB=8
# CZDS_MIN_FREE_GB=3
# CZDS_MAX_HITS_PER_ZONE=2000
# CZDS_SORT_BUFFER=128M                 # memory for `sort -S` (the worker container has mem_limit: 512m)
# CZDS_MAX_COUNT_CHANGE=0.2             # reject a zone file whose name count moved more than 20% from the last one
# CZDS_MAX_NEW_NAMES=1000000            # more new names than this in one day: store a new baseline, score nothing
# CZDS_STRICT_SOA=true                  # require a zone file to start and end with the same SOA record
# CZDS_KEEP_UNCONFIGURED_DAYS=7         # delete a TLD's lists this long after it leaves CZDS_TLDS
